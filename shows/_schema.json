{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "media-digest/show/v1",
  "title": "media-digest show file",
  "description": "一部剧一份。meta/about/episodes 由 scraper 维护（客观）；intro/route 在 session 里手写（主观），scraper 绝不改。",
  "type": "object",
  "required": [
    "meta",
    "episodes",
    "route"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "total_eps",
        "schema_version"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^_?[a-z0-9][a-z0-9-]*$",
          "description": "下划线开头 = 示例/测试文件，不进 index.json"
        },
        "title": {
          "type": "string"
        },
        "title_cn": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_native": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_eps": {
          "type": "integer",
          "minimum": 1
        },
        "primary_kpi": {
          "type": "string",
          "enum": [
            "imdb",
            "mal",
            "tmdb",
            "bangumi"
          ],
          "description": "页面默认评分维度。各源并存不合并、不加权（2026-09-13 定）；热度是另一维度，不在此列"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "schema_version": {
          "type": "integer"
        },
        "ids": {
          "type": "object",
          "properties": {
            "mal": {
              "type": [
                "string",
                "integer"
              ]
            },
            "bangumi": {
              "type": [
                "string",
                "integer"
              ]
            },
            "imdb": {
              "type": "string",
              "pattern": "^tt\\d+$"
            },
            "tmdb": {
              "type": [
                "string",
                "integer"
              ]
            },
            "wiki": {
              "type": "string"
            }
          }
        }
      }
    },
    "about": {
      "description": "scraper 自动填的作品级客观信息，页面在 intro 缺项时回退用它。",
      "type": "object",
      "properties": {
        "cover": {
          "type": [
            "string",
            "null"
          ]
        },
        "backdrop": {
          "type": [
            "string",
            "null"
          ]
        },
        "synopsis": {
          "$ref": "#/definitions/bilingual"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "studios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "type": "object"
        },
        "links": {
          "type": "object"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "characters_bangumi": {
          "type": "array"
        }
      }
    },
    "intro": {
      "description": "session 手写的作品介绍：头图 / 无剧透剧情简介 / 主要人物与动机 / 亮点 / 地位。全部可选，缺则页面回退到 about。",
      "type": "object",
      "properties": {
        "cover": {
          "type": [
            "string",
            "null"
          ],
          "description": "覆盖 about.cover 的头图 URL 或相对路径"
        },
        "synopsis": {
          "type": "string",
          "description": "无剧透剧情介绍（中文）"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "anyOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "name_cn"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "英文名；与 about.characters[].name 对得上时页面合并头像"
              },
              "name_cn": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "motivation": {
                "type": "string",
                "description": "这个人要什么、为什么"
              }
            }
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "亮点，一条一句"
        },
        "standing": {
          "type": "string",
          "description": "地位 / 评价 / 为什么值得看"
        },
        "logline": {
          "type": "string",
          "description": "一句话"
        },
        "route_note": {
          "type": "string",
          "description": "分层规则说明，写给未来的自己：为什么不是按评分取 top X%"
        },
        "spoiler_gate_from": {
          "type": "integer",
          "minimum": 1,
          "description": "从这一集起（含）分集梗概即使点按钮也要二次确认——全剧不可逆信息所在"
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "title_native": {
            "type": [
              "string",
              "null"
            ]
          },
          "title_en": {
            "type": [
              "string",
              "null"
            ]
          },
          "title_cn": {
            "type": [
              "string",
              "null"
            ]
          },
          "aired": {
            "type": [
              "string",
              "null"
            ]
          },
          "synopsis": {
            "$ref": "#/definitions/bilingual"
          },
          "sources": {
            "type": "object",
            "description": "多源并存不合并。脚本不加权、不算综合分。",
            "properties": {
              "mal": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "1–5 投票均分，两位小数"
                  },
                  "votes": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "forum_replies": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "imdb": {
                "type": "object",
                "properties": {
                  "rating": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "votes": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "tmdb": {
                "type": "object",
                "properties": {
                  "vote_average": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "vote_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "bangumi": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "votes": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "comments": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "heat": {
            "type": "object",
            "description": "「这集让多少人想说话」——与评分是两个维度，单列不合并。页面用它做热度维度和 🔥 标记",
            "properties": {
              "mal_replies": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bangumi_comments": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "imdb_votes": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "notes": {
            "type": "object",
            "description": "人写的分集内容（含剧透），来自 Drive episodes.json；脚本绝不改。页面按进度门控显示。",
            "properties": {
              "title_cn": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string",
                "description": "本集发生了什么、剧情推进到哪、主要人物做了什么"
              },
              "new": {
                "type": "array",
                "items": {
                  "type": "object",
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "name_cn"
                      ]
                    }
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "name_cn": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "recurring",
                        "arc",
                        "one-off"
                      ],
                      "description": "recurring=重要常驻 arc=阶段性 one-off=一次性"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "route": {
      "description": "有序、不重叠的路线节点。允许为空——只有 episodes 时页面也能渲染。",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "eps",
              "why"
            ],
            "properties": {
              "kind": {
                "const": "watch"
              },
              "eps": {
                "$ref": "#/definitions/range"
              },
              "why": {
                "type": "string"
              },
              "optional": {
                "type": "boolean",
                "description": "可选看：不影响主线，跳过也接得上"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "eps",
              "title",
              "paragraphs"
            ],
            "properties": {
              "kind": {
                "const": "bridge"
              },
              "eps": {
                "$ref": "#/definitions/range"
              },
              "title": {
                "type": "string"
              },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "definitions": {
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "[起, 止] 闭区间，单集写 [n, n]"
    },
    "bilingual": {
      "type": "object",
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
